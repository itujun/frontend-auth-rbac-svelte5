# URL base API backend (harus include /api). Prefix PUBLIC_ WAJIB --
# dibaca lewat $env/dynamic/public (runtime, dari process.env saat
# server jalan), BUKAN import.meta.env.VITE_* (build-time, dicetak
# permanen ke bundle saat `vite build`). Sengaja dipilih runtime supaya
# satu Docker image bisa dipakai lintas environment tanpa rebuild --
# lihat komentar di src/lib/api/client.ts dan src/hooks.server.ts.
PUBLIC_API_BASE_URL=http://localhost:3000/api

E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=